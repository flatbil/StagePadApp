<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>MD Buddy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2</string>
	<key>CFBundleVersion</key>
	<string>9</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_stagepad._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MD Buddy connects to the MD Buddy Bridge running on your Mac to receive live playback data from Ableton Live.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>AppLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- Base key must list all four orientations, including upside-down —
	     Apple's validator requires it for iPad multitasking (Split View /
	     Slide Over) support regardless of the ~ipad override below. This
	     key is what actually governs iPhone (no idiom-specific override
	     exists for iPhone), and is a fallback for iPad contexts the ~ipad
	     key doesn't cover (e.g. a multitasked pane can rotate independent
	     of the single-fullscreen-app restriction). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad-specific override deliberately excludes upside-down: a
	     physically flipped/bumped stage iPad mirroring its whole UI mid-
	     song is a real hazard, not a cosmetic one — confirmed live
	     2026-09-12. This is what actually governs normal (non-multitasked,
	     fullscreen) iPad presentation, which is how this app is used in
	     practice. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
